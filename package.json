{
  "name": "cleartweet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Chrome extension that deletes your posts on X from your data archive",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "zip": "npm run build && cd dist && zip -qr ../cleartweet.zip ."
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
